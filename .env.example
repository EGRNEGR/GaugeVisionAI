# GaugeVision AI — конфигурация автономного промышленного контура (air-gapped ready)
# Скопируйте в .env и настройте параметры объекта перед запуском.

# Основные параметры сервера
GAUGEVISION_HOST=0.0.0.0
GAUGEVISION_PORT=8443
GAUGEVISION_DEMO=1
GAUGEVISION_DEVICE=cpu

# Идентификация энергообъекта и Edge-узла
GAUGEVISION_EDGE_NODE_ID=edge-ktc-01
GAUGEVISION_PLANT_NAME=ТЭЦ-22 ПАО «Интер РАО» (Котлотурбинный цех)
GAUGEVISION_PLANT_BRANCH=Филиал «Московская генерация»

# Относительные пути к БД и локальным каталогам (от корня репозитория)
# GAUGEVISION_DB=data/gaugevision_demo.db
# GAUGEVISION_SF_DB=data/store_forward_demo.db
# GAUGEVISION_VIDEOS_DIR=data/videos

# Безопасность, аутентификация RBAC и сетевая изоляция (DEF-07)
GAUGEVISION_AUTH_REQUIRED=1
GAUGEVISION_SESSION_TTL=43200
GAUGEVISION_ALLOW_FAULT_INJECTION=0
GAUGEVISION_ALLOW_LOOPBACK_STREAMS=0
GAUGEVISION_ALLOW_EXTERNAL_STREAMS=0
# GAUGEVISION_ALLOWED_STREAM_CIDRS=192.168.10.0/24,10.20.0.0/16
# GAUGEVISION_CORS_ORIGINS=https://localhost:8443
# GAUGEVISION_SECRET_KEY=сгенерируйте-длинный-случайный-ключ-для-шифрования-rtsp-credentials
# Локальные учётные записи по умолчанию (обязательно смените перед вводом в эксплуатацию!):
GAUGEVISION_ADMIN_USER=admin
GAUGEVISION_ADMIN_PASS=GaugeAdmin!2026
GAUGEVISION_ENGINEER_USER=engineer
GAUGEVISION_ENGINEER_PASS=GaugeEng!2026
GAUGEVISION_OPERATOR_USER=operator
GAUGEVISION_OPERATOR_PASS=GaugeOp!2026

# Трек №2: Adaptive FPS (Event-Driven + Motion Pre-Trigger) и Store-and-Forward
GAUGEVISION_ADAPTIVE_FPS_IDLE=1.0
GAUGEVISION_ADAPTIVE_FPS_ACTIVE=6.0
GAUGEVISION_ADAPTIVE_HOLD_SECONDS=15.0
GAUGEVISION_ADAPTIVE_DELTA_PCT=2.5
GAUGEVISION_ADAPTIVE_MOTION_MAD=2.4
GAUGEVISION_ADAPTIVE_WAKE_INTERVAL=0.12
GAUGEVISION_RING_PRE_FRAMES=12
GAUGEVISION_RING_POST_FRAMES=8
GAUGEVISION_RING_MAX_CLIPS=20
GAUGEVISION_SF_BATCH_SIZE=40
GAUGEVISION_SF_MAX_QUEUE_ROWS=25000
GAUGEVISION_SF_MAX_PENDING_MB=128
GAUGEVISION_SF_MIN_DISK_FREE_MB=100
GAUGEVISION_SF_BATCH_DELAY=0.0

# Промышленная интеграция АСУ ТП (MQTT 3.1.1 QoS 1 и Modbus TCP)
GAUGEVISION_MQTT_ENABLED=0
GAUGEVISION_MQTT_HOST=127.0.0.1
GAUGEVISION_MQTT_PORT=1883
GAUGEVISION_MQTT_QOS=1
GAUGEVISION_MQTT_KEEPALIVE=30
GAUGEVISION_MQTT_ACK_TIMEOUT=2.5
GAUGEVISION_MQTT_TLS=0
GAUGEVISION_MQTT_USERNAME=
GAUGEVISION_MQTT_PASSWORD=
GAUGEVISION_MQTT_TOPIC_PREFIX=interrao/tec22/ktc/gaugevision

GAUGEVISION_MODBUS_ENABLED=0
GAUGEVISION_MODBUS_HOST=127.0.0.1
GAUGEVISION_MODBUS_PORT=15020
GAUGEVISION_MODBUS_UNIT_ID=1

# Трек №1: Умная диспетчеризация, ТЭО и опциональное LLM-обогащение ТЗ (Ollama / vLLM / OpenAI-compatible)
GAUGEVISION_WEAR_THRESHOLD=50.0
GAUGEVISION_AUTO_SPEC_COOLDOWN=3600
GAUGEVISION_ECO_COMMISSIONING_RATE=0.14
GAUGEVISION_ECO_ROUNDS_SAVINGS_RUB=38000
GAUGEVISION_ECO_OPEX_RUB=8000
# Оставьте пустым для 100% детерминированного автономного режима без интернета:
GAUGEVISION_LLM_BASE_URL=
GAUGEVISION_LLM_API_KEY=
GAUGEVISION_LLM_MODEL=qwen2.5:7b-instruct
GAUGEVISION_LLM_TIMEOUT=18.0
